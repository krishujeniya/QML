{
  "name": "qml-learning-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vite build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.5.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.72.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
